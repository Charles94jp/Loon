#!name=Spotify Premium
#!desc=✅解锁高音质、开放下载
#!category=Charles自用
#!author=各位大佬
#!homepage=https://github.com/Charles94jp/Loon/tree/master/Plugins
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Spotify.png
#!date=2026-01-31 13:08:00

[Rewrite]
# > Spotify if-none-match返回304状态码
^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$ header-del if-none-match

[Script]
# > Spotify解锁premium，下载，解锁高音质
# 2026-01-31测可用
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/ script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/JS/Spotify-Pro/JS/Spotify-Json.js, timeout=10, tag=Spotify解锁premium
http-response ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$ script-path=https://raw.githubusercontent.com/BOBOLAOSHIV587/Rules/main/JS/Spotify-Pro/JS/Spotify-Proto.js, requires-body=true, binary-body-mode=true, timeout=10, tag=Spotify解锁premium

[MITM]
hostname = spclient.wg.spotify.com, *spclient.spotify.com