[Script]
#http-response ^https?:\/\/(detailadr|commontgw).reader.qq.com\/(book\/queryDetailPage|.+nativepage\/personal|.+vip\/viptxt) script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/QQYD.js, requires-body=true, timeout=60
#http-request ^https?:\/\/newminerva-tgw.reader.qq.com\/ChapBatAuthWithPD script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/QQYD.js, timeout=60
http-response ^https?:\/\/(detailadr|commontgw).reader.qq.com\/(book\/queryDetailPage|.+nativepage\/personal|.+vip\/viptxt) script-path=https://gjds.vip/js/qq.js, requires-body=true, timeout=60
http-request ^https?:\/\/newminerva-tgw.reader.qq.com\/ChapBatAuthWithPD script-path=https://gjds.vip/js/qq.js, timeout=60

[MITM]
#hostname = *.reader.qq.com,newminerva-tgw.reader.qq.com,detailadr.reader.qq.com,commontgw.reader.qq.com
hostname = *.reader.qq.com,newminerva-tgw.reader.qq.com,detailadr.reader.qq.com,commontgw.reader.qq.com