[Script]
http-response ^https?:\/\/(detailadr|commontgw).reader.qq.com\/(book\/queryDetailPage|.+nativepage\/personal|.+vip\/viptxt) script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/QQYD.js, requires-body=true, binary-body-mode=true, timeout=10
http-request ^https?:\/\/newminerva-tgw.reader.qq.com\/ChapBatAuthWithPD script-path=https://raw.githubusercontent.com/WeiGiegie/666/main/QQYD.js, timeout=10

[MITM]
hostname = *.reader.qq.com,newminerva-tgw.reader.qq.com,detailadr.reader.qq.com,commontgw.reader.qq.com